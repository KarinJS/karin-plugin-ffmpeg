{
  "name": "@karinjs/plugin-ffmpeg",
  "version": "0.2.0",
  "author": "ikenxuan",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "description": "Provide Karin with an out of the box plugin for ffmpeg binary files",
  "homepage": "https://github.com/KarinJS/karin-plugin-ffmpeg",
  "bugs": {
    "url": "https://github.com/KarinJS/karin-plugin-ffmpeg/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarinJS/karin-plugin-ffmpeg.git"
  },
  "keywords": [
    "karin",
    "ffmpeg",
    "video",
    "audio",
    "media",
    "converter"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "cross-env EBV_FILE=\"development.env\" tsx src/app.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "pub": "npm publish --access public"
  },
  "main": "dist/index.mjs",
  "devDependencies": {
    "@types/node": "24.10.15",
    "cross-env": "^10.1.0",
    "node-karin": "1.17.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "karin": {
    "files": [
      "config"
    ],
    "main": "src/index.ts",
    "web": "dist/web.config.mjs",
    "ts-web": "src/web.config.ts"
  },
  "files": [
    "/dist/**/*.mjs",
    "/dist/**/*.d.mts",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
